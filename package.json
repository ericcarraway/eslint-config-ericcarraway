{
  "name": "@percuss.io/eslint-config-ericcarraway",
  "version": "9.0.0",
  "description": "Shareable ESLint rule sets for percuss.io JavaScript & TypeScript projects.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./types/index.d.ts",
  "files": [
    "index.js",
    "rules/",
    "types/"
  ],
  "scripts": {
    "build": "rm -rf types && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prerelease": "./scripts/prerelease.sh",
    "shipit": "./scripts/publish.sh",
    "test": "npm run build && node --test && npm run typecheck && npm run lint",
    "typecheck": "tsc -p tsconfig.json",
    "test:package": "node scripts/check-package.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericcarraway/eslint-config-ericcarraway.git"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "typescript"
  ],
  "author": "Eric L. Carraway",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ericcarraway/eslint-config-ericcarraway/issues"
  },
  "homepage": "https://github.com/ericcarraway/eslint-config-ericcarraway#readme",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "peerDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependenciesMeta": {
    "@stylistic/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-import": {
      "optional": true
    },
    "eslint-plugin-n": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-simple-import-sort": {
      "optional": true
    },
    "eslint-plugin-sort-destructure-keys": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
